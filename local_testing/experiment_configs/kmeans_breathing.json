{
  "runId": "example-kmeans-breathing-flink-local",
  "profile": "local",
  "outputDir": "benchmark-results",
  "dataset": {
    "type": "synthetic",
    "params": { "numPoints": 500000, "numPartitions": 8, "seed": 42 }
  },
  "algorithm": {
    "name": "kmeans",
    "params": { "k": 10, "maxIter": 20, "refine": "breathing", "m0": 5, "maxCycles": 10 }
  },
  "evaluation": {
    "metrics": ["silhouette", "nClusters", "clusterSizes"],
    "sampleSize": 5000,
    "seed": 42
  }
}
