{
  "runId": "example-kmeans-spherical-flink-local",
  "profile": "local",
  "outputDir": "benchmark-results",
  "dataset": {
    "type": "synthetic",
    "params": { "numPoints": 1000000, "numPartitions": 8, "seed": 42 }
  },
  "algorithm": {
    "name": "kmeans",
    "params": { "k": 10, "maxIter": 20, "geometry": "spherical" }
  },
  "evaluation": {
    "metrics": ["silhouette", "nClusters", "clusterSizes"],
    "sampleSize": 5000,
    "seed": 42
  }
}
